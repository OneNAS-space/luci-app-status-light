# probe 'auto': the DNS servers the WAN got (netifd) are asked, and pinged when they are public
# addresses, so the checks work in any country. The lists below are used for a family the WAN has
# no DNS server for, as ping targets when all of them are private, and for probe 'custom'
# (only the lists).
config status_light 'main'
	option enabled '1'
	option interval_ok '30'
	option interval_bad '5'
	option interval_fast '2'
	option fails '2'
	option monitor 'ubus'
	option probe 'auto'
	option dns_name 'openwrt.org'
	option dns_strict '1'
	option dns_timeout '3'
	option ping_timeout '2'
	list hosts4 '1.1.1.1'
	list hosts4 '8.8.8.8'
	list hosts6 '2606:4700:4700::1111'
	list hosts6 '2001:4860:4860::8888'
	list dns_upstream4 '1.1.1.1'
	list dns_upstream4 '8.8.8.8'
	list dns_upstream6 '2606:4700:4700::1111'
	list dns_upstream6 '2001:4860:4860::8888'

# What each scenario looks like: mode 'solid', 'flashing' (half = seconds on / off,
# default 0.25), 'system' (hand the LED back to the system LED configuration)
# or, for s1 only, 'easing' (the breathing light entries of the system LED configuration).
# Levels are 0-255 per channel.
config look 's1'
	option mode 'system'

config look 's2'
	option mode 'solid'
	option red '0'
	option green '255'
	option blue '0'

config look 's3'
	option mode 'solid'
	option red '0'
	option green '45'
	option blue '255'

config look 's4'
	option mode 'flashing'
	option half '1'
	option red '0'
	option green '255'
	option blue '0'

config look 's5'
	option mode 'flashing'
	option half '1'
	option red '0'
	option green '0'
	option blue '255'

config look 's6'
	option mode 'flashing'
	option half '0.25'
	option red '255'
	option green '115'
	option blue '0'

config look 's7'
	option mode 'solid'
	option red '255'
	option green '30'
	option blue '0'

config look 's8'
	option mode 'solid'
	option red '255'
	option green '0'
	option blue '0'
