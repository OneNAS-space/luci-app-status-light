config status_light 'main'
	option enabled '1'
	option interval_ok '30'
	option interval_bad '5'
	option interval_fast '2'
	option fails '2'
	option monitor 'ubus'
	option dns_name 'www.baidu.com'
	option dns_strict '1'
	option dns_timeout '3'
	option ping_timeout '2'
	list hosts4 '223.5.5.5'
	list hosts4 '119.29.29.29'
	list hosts6 '2400:3200::1'
	list dns_upstream4 '223.5.5.5'
	list dns_upstream4 '119.29.29.29'
	list dns_upstream6 '2400:3200::1'
	list dns_upstream6 '2402:4e00::'

# What each scenario looks like: mode 'solid', 'flashing' (half = seconds on / off,
# default 0.25), 'system' (hand the LED back to the system LED configuration)
# or, for s1 only, 'easing' (the breathing light entries of the system LED configuration).
# Levels are 0-255 per channel.
config look 's1'
	option mode 'system'

config look 's2'
	option mode 'solid'
	option red '0'
	option green '255'
	option blue '0'

config look 's3'
	option mode 'solid'
	option red '0'
	option green '45'
	option blue '255'

config look 's4'
	option mode 'flashing'
	option half '1'
	option red '0'
	option green '255'
	option blue '0'

config look 's5'
	option mode 'flashing'
	option half '1'
	option red '0'
	option green '0'
	option blue '255'

config look 's6'
	option mode 'flashing'
	option half '0.25'
	option red '255'
	option green '115'
	option blue '0'

config look 's7'
	option mode 'solid'
	option red '255'
	option green '30'
	option blue '0'

config look 's8'
	option mode 'solid'
	option red '255'
	option green '0'
	option blue '0'
