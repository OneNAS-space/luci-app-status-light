#!/bin/sh /etc/rc.common

START=97
STOP=10
USE_PROCD=1

PIDFILE=/var/run/status-light.pid

start_service() {
	[ "$(uci -q get status_light.main.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/status-light
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# Settings changed: tell the running daemon to read them again (no restart, the LED does
# not flicker). Start it when it was off, stop it when it was switched off.
reload_service() {
	local pid

	if [ "$(uci -q get status_light.main.enabled)" != 1 ]; then
		stop
		return 0
	fi

	pid="$(cat "$PIDFILE" 2>/dev/null)"
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		kill -HUP "$pid"
	else
		restart
	fi
}

service_triggers() {
	# system: the LED entries of the system LED configuration (see reset_orphans in the daemon)
	procd_add_reload_trigger status_light system
}
